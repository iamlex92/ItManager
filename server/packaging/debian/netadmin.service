[Unit]
Description=NetAdmin DCIM server
Documentation=https://github.com/iamlex92/ItManager/blob/master/server/DEPLOY.md
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=netadmin
Group=netadmin
ExecStart=/opt/netadmin/netadmin-agent run --config /etc/netadmin/netadmin.env
WorkingDirectory=/var/lib/netadmin
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
# Port 162 for SNMP traps and ping for the heartbeat, without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/netadmin

[Install]
WantedBy=multi-user.target
