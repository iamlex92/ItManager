# Copy to .env and fill in.

# Shared secret the Android app sends as "Authorization: Bearer <token>".
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

POSTGRES_PASSWORD=netadmin

# emulator (default): fake switches, nothing touches the network.
# real: talk to the production Cisco/Eltex switches (driver not implemented yet).
HAL_MODE=emulator

# Only matters with HAL_MODE=real. Keep false unless you really intend the
# server to change switch configuration. Even when true, every write needs
# "confirm": true in the request (and "confirm_uplink": true for uplinks).
ALLOW_DEVICE_WRITES=false

# Fill an empty database with the demo floor on first start.
SEED_DEMO_DATA=true

POLL_INTERVAL_SECONDS=10
EMULATOR_FLAP_PROBABILITY=0.1
