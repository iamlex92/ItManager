# Copy to .env and fill in.

# Shared secret the Android app sends as "Authorization: Bearer <token>".
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# Key that encrypts SNMP communities and stored credentials in the database.
# Generate once and keep a copy with the backups' passwords: without it the
# encrypted values (and a restored backup) cannot be read.
#   openssl rand -base64 32 | tr '+/' '-_'
SECRET_KEY=

# Database password. Change it before the first start (it is baked into the
# data volume on first start; changing it later needs ALTER USER in psql).
POSTGRES_PASSWORD=netadmin

# Address the API listens on for phones: the server's plant or VPN interface.
API_BIND=0.0.0.0

# Database dumps to ./backups: every N hours, kept for N days.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14

# emulator (default): fake switches, nothing touches the network.
# real: talk to the production Cisco/Eltex switches (driver not implemented yet).
HAL_MODE=emulator

# Only matters with HAL_MODE=real. Keep false unless you really intend the
# server to change switch configuration. Even when true, every write needs
# "confirm": true in the request (and "confirm_uplink": true for uplinks).
ALLOW_DEVICE_WRITES=false

# Fill an empty database with the demo floor on first start.
# On the plant server set false and build the inventory with the network scanner.
SEED_DEMO_DATA=true

POLL_INTERVAL_SECONDS=10
EMULATOR_FLAP_PROBABILITY=0.1

# --- Monitoring (read-only towards devices) ---
# emulator: printers and reachability are simulated.
# real: SNMP GET to printers (Printer-MIB) and ICMP ping to every device.
MONITOR_MODE=emulator
PRINTER_POLL_INTERVAL_SECONDS=300
HEARTBEAT_INTERVAL_SECONDS=15

# SNMP traps (linkDown/linkUp) from switches. 0 disables the listener.
TRAP_LISTEN_PORT=1162
TRAP_COMMUNITY=public

# SNMP for printer polling. Per-device community comes from the device's
# snmp_community field when SNMP_VERSION=2c.
SNMP_VERSION=2c
# SNMP_V3_USER=
# SNMP_V3_AUTH_KEY=
# SNMP_V3_PRIV_KEY=
# SNMP_V3_AUTH_PROTOCOL=SHA      # MD5 | SHA | SHA256
# SNMP_V3_PRIV_PROTOCOL=AES      # DES | AES
